{
  "name": "vibejam-magic-duel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "build:cloudflare": "npm run build --workspace client && node tools/prepare-cloudflare-assets.mjs",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "test": "npm run test --workspace server",
    "deploy:cloudflare": "wrangler deploy",
    "splat:collision": "node tools/generate-splat-collision.mjs",
    "splat:qualities": "node tools/generate-splat-qualities.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.87.0"
  },
  "engines": {
    "node": ">=20"
  }
}
