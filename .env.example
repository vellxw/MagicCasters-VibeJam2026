PORT=3001
SERVER_PORT=3001
VITE_COLYSEUS_URL=ws://localhost:3001

# Local private access for F8/F9 dev editors.
# Generate these with:
# node tools/generate-dev-access-verifier.mjs --write-env
DEV_ACCESS_PASSWORD_SALT=
DEV_ACCESS_PASSWORD_KEY=
DEV_ACCESS_PASSWORD_ITERATIONS=210000
DEV_ACCESS_REMOTE_ENABLED=
DEV_ACCESS_ALLOWED_ORIGINS=

# Production Fly.io note:
# Do not set VITE_COLYSEUS_URL when the built client is served by the same
# Fly app as Colyseus. The client will use wss:// on the current HTTPS origin
# automatically.
